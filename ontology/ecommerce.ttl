eco:S01 a owl:NamedIndividual,
        eco:Stock ;
    eco:concerneProduit eco:P01 ;
    eco:estStockeDans eco:E01 ;
    eco:quantite 12 .

eco:S02 a owl:NamedIndividual,
        eco:Stock ;
