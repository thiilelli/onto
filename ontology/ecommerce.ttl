eco:Cat02 a owl:NamedIndividual,
        eco:Categorie ;
    eco:nomCategorie "Téléphonie" ;
    eco:regroupe eco:P02 .

eco:Cat03 a owl:NamedIndividual,
        eco:Categorie ;
    eco:nomCategorie "Informatique" ;
    eco:regroupe eco:P03 .

eco:Cp01 a owl:NamedIndividual,
        eco:Coupon ;
    eco:appliqueCouponA eco:O01 ;
    eco:code "WELCOME10" ;
