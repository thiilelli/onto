eco:Cp02 a owl:NamedIndividual,
        eco:Coupon ;
    eco:appliqueCouponA eco:O02 ;
    eco:code "NOEL20" ;
    eco:dateCoupon "2025-12-25T13:30:04"^^xsd:dateTime .

eco:E02 a owl:NamedIndividual,
        eco:Entrepot ;
    eco:adresseEntrepot "Oran, Es Senia" ;
    eco:capacite 20 ;
