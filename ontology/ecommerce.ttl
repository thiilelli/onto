var:c a swrl:Variable .

eco:Categorie a owl:Class ;
    rdfs:label "Category"@en,
        "Catégorie"@fr ;
    rdfs:comment "Regroupement thématique de produits."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Produit ;
            owl:onProperty eco:regroupe ] .

eco:Entrepot a owl:Class ;
    rdfs:label "Warehouse"@en,
        "Entrepôt"@fr ;
    rdfs:comment "Lieu physique de stockage."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Stock ;
            owl:onProperty eco:stocke ] .

eco:Facture a owl:Class ;
    rdfs:label "Invoice"@en,
        "Facture"@fr ;
    rdfs:comment "Document comptable généré par une commande."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass eco:Commande ;
            owl:onProperty eco:estGenereePar ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

eco:Fournisseur a owl:Class ;
    rdfs:label "Supplier"@en,
        "Fournisseur"@fr ;
    rdfs:comment "Organisation qui fournit des produits."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Produit ;
            owl:onProperty eco:fournit ] .

eco:ServiceClient a owl:Class ;
    rdfs:label "Customer service"@en,
        "Service client"@fr ;
    rdfs:comment "Service qui gère le suivi des commandes."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Commande ;
            owl:onProperty eco:gere ] .

eco:Avis a owl:Class ;
    rdfs:label "Review"@en,
        "Avis"@fr ;
    rdfs:comment "Évaluation d'un produit rédigée par un client."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass eco:Client ;
            owl:onProperty eco:estEcritPar ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass eco:Produit ;
            owl:onProperty eco:concerne ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

eco:Paiement a owl:Class ;
    rdfs:label "Payment"@en,
        "Paiement"@fr ;
    rdfs:comment "Règlement effectué par un client."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass eco:Commande ;
            owl:onProperty eco:regle ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass eco:Client ;
            owl:onProperty eco:estEffectuePar ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

eco:Boutique a owl:Class ;
    rdfs:label "Shop"@en,
        "Boutique"@fr ;
    rdfs:comment "Point de vente qui commercialise des produits."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Produit ;
            owl:onProperty eco:vend ] .

eco:Client a owl:Class ;
    rdfs:label "Customer"@en,
        "Client"@fr ;
    rdfs:comment "Personne qui passe des commandes et effectue des paiements."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Avis ;
            owl:onProperty eco:ecrit ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Commande ;
            owl:onProperty eco:passe ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Paiement ;
            owl:onProperty eco:effectue ] .

eco:Stock a owl:Class ;
    rdfs:label "Stock"@en,
        "Stock"@fr ;
    rdfs:comment "Quantité disponible d'un produit dans un entrepôt."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass eco:Produit ;
            owl:onProperty eco:concerneProduit ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass eco:Entrepot ;
            owl:onProperty eco:estStockeDans ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

eco:Commande a owl:Class ;
    rdfs:label "Order"@en,
        "Commande"@fr ;
    rdfs:comment "Ensemble de produits commandés par un client."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass eco:ServiceClient ;
            owl:onProperty eco:estGereePar ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Coupon ;
            owl:onProperty eco:aPourCoupon ],
        [ a owl:Restriction ;
            owl:onClass eco:Paiement ;
            owl:onProperty eco:estPayeePar ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "20"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Produit ;
            owl:onProperty eco:contient ],
        [ a owl:Restriction ;
            owl:onClass eco:Livraison ;
            owl:onProperty eco:estLivreePar ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Produit ;
            owl:onProperty eco:contient ],
        [ a owl:Restriction ;
            owl:onClass eco:Client ;
            owl:onProperty eco:estPasseePar ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass eco:Facture ;
            owl:onProperty eco:genere ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

eco:Produit a owl:Class ;
    rdfs:label "Product"@en,
        "Produit"@fr ;
    rdfs:comment "Article proposé à la vente."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Stock ;
            owl:onProperty eco:aPourStock ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Avis ;
            owl:onProperty eco:aPourAvis ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Boutique ;
            owl:onProperty eco:estVenduPar ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Fournisseur ;
            owl:onProperty eco:estFourniPar ],
        [ a owl:Restriction ;
            owl:onClass eco:Categorie ;
            owl:onProperty eco:appartientA ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Commande ;
            owl:onProperty eco:figureDans ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Remise ;
            owl:onProperty eco:aPourRemise ] .

[] a owl:AllDisjointClasses ;
    owl:members ( eco:Avis eco:Boutique eco:Categorie eco:Client eco:Commande eco:Coupon eco:Entrepot eco:Facture eco:Fournisseur eco:Livraison eco:Paiement eco:Produit eco:Remise eco:ServiceClient eco:Stock ) .

[] a swrl:Imp ;
    rdfs:label "R1 - Commande prioritaire" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Toute commande livrée par une livraison express est prioritaire."@fr ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:c ;
                    swrl:classPredicate eco:Commande ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:c ;
                            swrl:argument2 var:l ;
                            swrl:propertyPredicate eco:estLivreePar ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 var:l ;
                                    swrl:classPredicate eco:LivraisonExpress ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:c ;
                    swrl:classPredicate eco:CommandePrioritaire ] ;
            rdf:rest () ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( eco:A01 eco:A02 eco:B01 eco:B02 eco:B03 eco:C01 eco:C02 eco:Cat01 eco:Cat02 eco:Cat03 eco:Cat04 eco:Cp01 eco:Cp02 eco:E01 eco:E02 eco:E03 eco:F01 eco:F02 eco:F03 eco:Fa01 eco:Fa02 eco:L01 eco:L02 eco:O01 eco:O02 eco:P01 eco:P02 eco:P03 eco:P04 eco:P05 eco:Pay01 eco:Pay02 eco:R01 eco:R02 eco:S01 eco:S02 eco:S03 eco:S04 eco:S05 eco:SC01 eco:SC02 ) .

[] a swrl:Imp ;
    rdfs:label "R2 - Produit vendable" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Un produit est vendable s'il est vendu par une boutique et associé à un stock de quantité > 0."@fr ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:p ;
                    swrl:classPredicate eco:Produit ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:b ;
                            swrl:argument2 var:p ;
                            swrl:propertyPredicate eco:vend ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 var:b ;
                                    swrl:classPredicate eco:Boutique ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 var:s ;
                                            swrl:argument2 var:p ;
                                            swrl:propertyPredicate eco:concerneProduit ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 var:s ;
                                                    swrl:classPredicate eco:Stock ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:DatavaluedPropertyAtom ;
                                                            swrl:argument1 var:s ;
                                                            swrl:argument2 var:q ;
                                                            swrl:propertyPredicate eco:quantite ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:BuiltinAtom ;
                                                                    swrl:arguments ( var:q 0 ) ;
                                                                    swrl:builtin swrlb:greaterThan ] ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:p ;
                    swrl:classPredicate eco:ProduitVendable ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    rdfs:label "R3 - Commande valide" ;
    swrla:isRuleEnabled true ;
    rdfs:comment "Une commande est valide si elle contient au moins un produit, génère une facture et est payée."@fr ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:c ;
                    swrl:classPredicate eco:Commande ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:c ;
                            swrl:argument2 var:p ;
                            swrl:propertyPredicate eco:contient ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:ClassAtom ;
                                    swrl:argument1 var:p ;
                                    swrl:classPredicate eco:Produit ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 var:c ;
                                            swrl:argument2 var:f ;
                                            swrl:propertyPredicate eco:genere ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:ClassAtom ;
                                                    swrl:argument1 var:f ;
                                                    swrl:classPredicate eco:Facture ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 var:c ;
                                                            swrl:argument2 var:pay ;
                                                            swrl:propertyPredicate eco:estPayeePar ] ;
                                                    rdf:rest [ a swrl:AtomList ;
                                                            rdf:first [ a swrl:ClassAtom ;
                                                                    swrl:argument1 var:pay ;
                                                                    swrl:classPredicate eco:Paiement ] ;
                                                            rdf:rest () ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:c ;
                    swrl:classPredicate eco:CommandeValide ] ;
            rdf:rest () ] .

