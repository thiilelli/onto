eco:O02 a owl:NamedIndividual,
        eco:Commande ;
    eco:aPourCoupon eco:Cp02 ;
    eco:contient eco:P02,
        eco:P05 ;
    eco:dateCommande "2025-12-09T14:30:00"^^xsd:dateTime ;
    eco:estGereePar eco:SC02 ;
    eco:estLivreePar eco:L02 ;
    eco:estPasseePar eco:C02 ;
    eco:estPayeePar eco:Pay02 ;
    eco:genere eco:Fa02 ;
    eco:statut "Livrée" .

eco:Remise a owl:Class ;
    rdfs:label "Discount"@en,
        "Remise"@fr ;
    rdfs:comment "Réduction en pourcentage appliquée à un produit."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass eco:Produit ;
            owl:onProperty eco:appliqueRemiseA ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

eco:Coupon a owl:Class ;
    rdfs:label "Coupon"@en,
        "Coupon"@fr ;
    rdfs:comment "Code promotionnel applicable à une commande."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass eco:Commande ;
            owl:onProperty eco:appliqueCouponA ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

eco:P01 a owl:NamedIndividual,
        eco:Produit ;
    eco:aPourRemise eco:R01 ;
