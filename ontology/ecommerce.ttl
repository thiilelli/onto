eco:F02 a owl:NamedIndividual,
        eco:Fournisseur ;
    eco:emailFournisseur "apple@mail.com" ;
    eco:fournit eco:P02 ;
    eco:nomFournisseur "Apple" .

eco:Fa01 a owl:NamedIndividual,
        eco:Facture ;
    eco:dateFacture "2025-12-10T14:40:00"^^xsd:dateTime ;
    eco:estGenereePar eco:O01 ;
    eco:numero 1 .

eco:Fa02 a owl:NamedIndividual,
        eco:Facture ;
    eco:dateFacture "2025-12-09T14:40:00"^^xsd:dateTime ;
    eco:estGenereePar eco:O02 ;
    eco:numero 2 .

eco:L01 a owl:NamedIndividual,
        eco:LivraisonExpress ;
    eco:dateLivraison "2025-12-11T10:00:00"^^xsd:dateTime ;
    eco:livre eco:O01 .

eco:L02 a owl:NamedIndividual,
        eco:LivraisonStandard ;
    eco:dateLivraison "2025-12-13T15:00:00"^^xsd:dateTime ;
    eco:livre eco:O02 .

eco:LivraisonExpress a owl:Class ;
    rdfs:label "Express delivery"@en,
        "Livraison express"@fr ;
    rdfs:subClassOf eco:Livraison ;
    owl:disjointWith eco:LivraisonStandard .

eco:LivraisonStandard a owl:Class ;
    rdfs:label "Standard delivery"@en,
        "Livraison standard"@fr ;
    rdfs:subClassOf eco:Livraison .

eco:PaiementMainAMain a owl:Class ;
    rdfs:label "Cash payment"@en,
        "Paiement de main à main"@fr ;
    rdfs:subClassOf eco:Paiement .

eco:R01 a owl:NamedIndividual,
        eco:Remise ;
    eco:appliqueRemiseA eco:P01 ;
    eco:pourcentage 10.0 .

eco:R02 a owl:NamedIndividual,
        eco:Remise ;
    eco:appliqueRemiseA eco:P05 ;
    eco:pourcentage 20.0 .

eco:SC01 a owl:NamedIndividual,
        eco:ServiceClient ;
    eco:emailServiceClient "supporttech@mail.com" ;
    eco:gere eco:O01 ;
    eco:nomServiceClient "SupportTech" ;
    eco:telephoneServiceClient "0555456789" .

eco:SC02 a owl:NamedIndividual,
        eco:ServiceClient ;
    eco:emailServiceClient "supportmaison@mail.com" ;
    eco:gere eco:O02 ;
    eco:nomServiceClient "SupportMaison" ;
    eco:telephoneServiceClient "0555567890" .

eco:aPourAvis a owl:ObjectProperty ;
    rdfs:label "has review"@en,
        "a pour avis"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range eco:Avis .

eco:aPourCoupon a owl:ObjectProperty ;
    rdfs:label "has coupon"@en,
        "a pour coupon"@fr ;
    rdfs:domain eco:Commande ;
    rdfs:range eco:Coupon .

eco:aPourRemise a owl:ObjectProperty ;
    rdfs:label "has discount"@en,
        "a pour remise"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range eco:Remise .

eco:aPourStock a owl:ObjectProperty ;
    rdfs:label "has stock"@en,
        "a pour stock"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range eco:Stock .

eco:adresse a owl:DatatypeProperty ;
    rdfs:label "address"@en,
        "adresse"@fr ;
    rdfs:comment "Propriété générique : ses sous-propriétés précisent le domaine."@fr ;
    rdfs:range xsd:string .

eco:concerneProduit a owl:ObjectProperty ;
    rdfs:label "is stock of"@en,
        "concerne le produit"@fr ;
    rdfs:domain eco:Stock ;
    rdfs:range eco:Produit ;
    owl:inverseOf eco:aPourStock .

eco:estEcritPar a owl:ObjectProperty ;
    rdfs:label "is written by"@en,
        "est écrit par"@fr ;
    rdfs:domain eco:Avis ;
    rdfs:range eco:Client .

eco:estEffectuePar a owl:ObjectProperty ;
    rdfs:label "is made by"@en,
        "est effectué par"@fr ;
    rdfs:domain eco:Paiement ;
    rdfs:range eco:Client .

eco:estFourniPar a owl:ObjectProperty ;
    rdfs:label "is supplied by"@en,
        "est fourni par"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range eco:Fournisseur .

eco:estGenereePar a owl:ObjectProperty ;
    rdfs:label "is generated by"@en,
        "est générée par"@fr ;
    rdfs:domain eco:Facture ;
    rdfs:range eco:Commande .

eco:estGereePar a owl:ObjectProperty ;
    rdfs:label "is handled by"@en,
        "est gérée par"@fr ;
    rdfs:domain eco:Commande ;
    rdfs:range eco:ServiceClient .

eco:estPasseePar a owl:ObjectProperty ;
    rdfs:label "is placed by"@en,
        "est passée par"@fr ;
    rdfs:domain eco:Commande ;
    rdfs:range eco:Client .

eco:estPayeePar a owl:ObjectProperty ;
    rdfs:label "is paid by"@en,
        "est payée par"@fr ;
    rdfs:domain eco:Commande ;
    rdfs:range eco:Paiement ;
    owl:inverseOf eco:regle .

eco:estStockeDans a owl:ObjectProperty ;
    rdfs:label "is stored in"@en,
        "est stocké dans"@fr ;
    rdfs:domain eco:Stock ;
    rdfs:range eco:Entrepot .

eco:estVenduPar a owl:ObjectProperty ;
    rdfs:label "is sold by"@en,
        "est vendu par"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range eco:Boutique .

eco:figureDans a owl:ObjectProperty ;
    rdfs:label "is in order"@en,
        "figure dans"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range eco:Commande .

eco:genere a owl:ObjectProperty ;
    rdfs:label "generates"@en,
        "génère"@fr ;
    rdfs:domain eco:Commande ;
    rdfs:range eco:Facture ;
    owl:inverseOf eco:estGenereePar .

eco:regle a owl:ObjectProperty ;
    rdfs:label "pays for"@en,
        "règle"@fr ;
    rdfs:domain eco:Paiement ;
    rdfs:range eco:Commande .

eco:regroupe a owl:ObjectProperty ;
    rdfs:label "groups"@en,
        "regroupe"@fr ;
    rdfs:domain eco:Categorie ;
    rdfs:range eco:Produit .

eco:telephone a owl:DatatypeProperty ;
    rdfs:label "phone"@en,
        "téléphone"@fr ;
    rdfs:comment "Propriété générique : ses sous-propriétés précisent le domaine."@fr ;
    rdfs:range xsd:string .

eco:vend a owl:ObjectProperty ;
    rdfs:label "sells"@en,
        "vend"@fr ;
    rdfs:domain eco:Boutique ;
    rdfs:range eco:Produit ;
    owl:inverseOf eco:estVenduPar .

var:b a swrl:Variable .

var:f a swrl:Variable .

var:l a swrl:Variable .

var:pay a swrl:Variable .

var:q a swrl:Variable .

