@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eco: <https://thiilelli.github.io/Onto/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix var: <https://thiilelli.github.io/Onto/ontology/var#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://thiilelli.github.io/Onto/ontology> a owl:Ontology ;
    dcterms:created "2025-11"^^xsd:gYearMonth ;
    dcterms:creator "Thilleli Rouas" ;
    dcterms:description "Ontologie OWL 2 du domaine du commerce électronique (clients, commandes, produits, stocks, paiements, livraisons) avec règles SWRL d'inférence et jeu d'individus de test."@fr ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:modified "2026-09-15"^^xsd:date ;
    dcterms:title "E-commerce ontology"@en,
        "Ontologie e-commerce"@fr ;
    vann:preferredNamespacePrefix "eco" ;
    vann:preferredNamespaceUri "https://thiilelli.github.io/Onto/ontology#" ;
    owl:versionIRI <https://thiilelli.github.io/Onto/ontology/1.0.0> ;
    owl:versionInfo "1.0.0" .

eco:adresseBoutique a owl:DatatypeProperty ;
    rdfs:label "shop address"@en,
        "adresse de la boutique"@fr ;
    rdfs:domain eco:Boutique ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:adresse .

eco:adresseEntrepot a owl:DatatypeProperty ;
    rdfs:label "warehouse address"@en,
        "adresse de l'entrepôt"@fr ;
    rdfs:domain eco:Entrepot ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:adresse .

eco:capacite a owl:DatatypeProperty ;
    rdfs:label "capacity"@en,
        "capacité"@fr ;
    rdfs:domain eco:Entrepot ;
    rdfs:range xsd:integer .

eco:code a owl:DatatypeProperty ;
    rdfs:label "code"@en,
        "code"@fr ;
    rdfs:domain eco:Coupon ;
    rdfs:range xsd:string .

eco:commentaire a owl:DatatypeProperty ;
    rdfs:label "comment"@en,
        "commentaire"@fr ;
    rdfs:domain eco:Avis ;
    rdfs:range xsd:string .

eco:dateCommande a owl:DatatypeProperty ;
    rdfs:label "order date"@en,
        "date de commande"@fr ;
    rdfs:domain eco:Commande ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf eco:date .

eco:dateCoupon a owl:DatatypeProperty ;
    rdfs:label "coupon date"@en,
        "date du coupon"@fr ;
    rdfs:domain eco:Coupon ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf eco:date .

eco:dateFacture a owl:DatatypeProperty ;
    rdfs:label "invoice date"@en,
        "date de facturation"@fr ;
    rdfs:domain eco:Facture ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf eco:date .

eco:dateLivraison a owl:DatatypeProperty ;
    rdfs:label "delivery date"@en,
        "date de livraison"@fr ;
    rdfs:domain eco:Livraison ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf eco:date .

eco:datePaiement a owl:DatatypeProperty ;
    rdfs:label "payment date"@en,
        "date de paiement"@fr ;
    rdfs:domain eco:Paiement ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf eco:date .

eco:description a owl:DatatypeProperty ;
    rdfs:label "description"@en,
        "description"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range xsd:string .

eco:emailBoutique a owl:DatatypeProperty ;
    rdfs:label "shop email"@en,
        "email de la boutique"@fr ;
    rdfs:domain eco:Boutique ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:email .

eco:emailClient a owl:DatatypeProperty ;
    rdfs:label "customer email"@en,
        "email du client"@fr ;
    rdfs:domain eco:Client ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:email .

eco:emailFournisseur a owl:DatatypeProperty ;
    rdfs:label "supplier email"@en,
        "email du fournisseur"@fr ;
    rdfs:domain eco:Fournisseur ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:email .

eco:emailServiceClient a owl:DatatypeProperty ;
    rdfs:label "customer service email"@en,
        "email du service client"@fr ;
    rdfs:domain eco:ServiceClient ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:email .

eco:montant a owl:DatatypeProperty ;
    rdfs:label "amount"@en,
        "montant"@fr ;
    rdfs:domain eco:Paiement ;
    rdfs:range xsd:decimal .

eco:nomBoutique a owl:DatatypeProperty ;
    rdfs:label "shop name"@en,
        "nom de la boutique"@fr ;
    rdfs:domain eco:Boutique ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:nom .

eco:nomCategorie a owl:DatatypeProperty ;
    rdfs:label "category name"@en,
        "nom de la catégorie"@fr ;
    rdfs:domain eco:Categorie ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:nom .

eco:nomClient a owl:DatatypeProperty ;
    rdfs:label "customer name"@en,
        "nom du client"@fr ;
    rdfs:domain eco:Client ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:nom .

eco:nomFournisseur a owl:DatatypeProperty ;
    rdfs:label "supplier name"@en,
        "nom du fournisseur"@fr ;
    rdfs:domain eco:Fournisseur ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:nom .

eco:nomProduit a owl:DatatypeProperty ;
    rdfs:label "product name"@en,
        "nom du produit"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:nom .

eco:nomServiceClient a owl:DatatypeProperty ;
    rdfs:label "customer service name"@en,
        "nom du service client"@fr ;
    rdfs:domain eco:ServiceClient ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:nom .

eco:note a owl:DatatypeProperty ;
    rdfs:label "rating"@en,
        "note"@fr ;
    rdfs:domain eco:Avis ;
    rdfs:range xsd:integer .

eco:numero a owl:DatatypeProperty ;
    rdfs:label "number"@en,
        "numéro"@fr ;
    rdfs:domain eco:Facture ;
    rdfs:range xsd:integer .

eco:pourcentage a owl:DatatypeProperty ;
    rdfs:label "percentage"@en,
        "pourcentage"@fr ;
    rdfs:domain eco:Remise ;
    rdfs:range xsd:decimal .

eco:prix a owl:DatatypeProperty ;
    rdfs:label "price"@en,
        "prix"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range xsd:decimal .

eco:specialite a owl:DatatypeProperty ;
    rdfs:label "specialty"@en,
        "spécialité"@fr ;
    rdfs:domain eco:Boutique ;
    rdfs:range xsd:string .

eco:statut a owl:DatatypeProperty ;
    rdfs:label "status"@en,
        "statut"@fr ;
    rdfs:domain eco:Commande ;
    rdfs:range xsd:string .

eco:telephoneBoutique a owl:DatatypeProperty ;
    rdfs:label "shop phone"@en,
        "téléphone de la boutique"@fr ;
    rdfs:domain eco:Boutique ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:telephone .

eco:telephoneServiceClient a owl:DatatypeProperty ;
    rdfs:label "customer service phone"@en,
        "téléphone du service client"@fr ;
    rdfs:domain eco:ServiceClient ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eco:telephone .

eco:CommandePrioritaire a owl:Class ;
    rdfs:label "Priority order"@en,
        "Commande prioritaire"@fr ;
    rdfs:comment "Classe inférée : commande livrée par une livraison express (règle R1)."@fr ;
    rdfs:subClassOf eco:Commande .

eco:CommandeValide a owl:Class ;
    rdfs:label "Valid order"@en,
        "Commande valide"@fr ;
    rdfs:comment "Classe inférée : commande avec au moins un produit, une facture et un paiement (règle R3)."@fr ;
    rdfs:subClassOf eco:Commande .

eco:PaiementCarte a owl:Class ;
    rdfs:label "Card payment"@en,
        "Paiement par carte"@fr ;
    rdfs:subClassOf eco:Paiement ;
    owl:disjointWith eco:PaiementMainAMain .

eco:ProduitVendable a owl:Class ;
    rdfs:label "Sellable product"@en,
        "Produit vendable"@fr ;
    rdfs:comment "Classe inférée : produit vendu par une boutique et en stock (règle R2)."@fr ;
    rdfs:subClassOf eco:Produit .

eco:appartientA a owl:ObjectProperty ;
    rdfs:label "belongs to"@en,
        "appartient à"@fr ;
    rdfs:domain eco:Produit ;
    rdfs:range eco:Categorie ;
    owl:inverseOf eco:regroupe .

eco:appliqueCouponA a owl:ObjectProperty ;
    rdfs:label "applies to order"@en,
        "applique le coupon à"@fr ;
    rdfs:domain eco:Coupon ;
    rdfs:range eco:Commande ;
    owl:inverseOf eco:aPourCoupon .

eco:appliqueRemiseA a owl:ObjectProperty ;
    rdfs:label "applies to product"@en,
        "applique la remise à"@fr ;
    rdfs:domain eco:Remise ;
    rdfs:range eco:Produit ;
    owl:inverseOf eco:aPourRemise .

eco:concerne a owl:ObjectProperty ;
    rdfs:label "is about"@en,
        "concerne"@fr ;
    rdfs:domain eco:Avis ;
    rdfs:range eco:Produit ;
    owl:inverseOf eco:aPourAvis .

eco:ecrit a owl:ObjectProperty ;
    rdfs:label "writes"@en,
        "écrit"@fr ;
    rdfs:domain eco:Client ;
    rdfs:range eco:Avis ;
    owl:inverseOf eco:estEcritPar .

eco:effectue a owl:ObjectProperty ;
    rdfs:label "makes"@en,
        "effectue"@fr ;
    rdfs:domain eco:Client ;
    rdfs:range eco:Paiement ;
    owl:inverseOf eco:estEffectuePar .

eco:fournit a owl:ObjectProperty ;
    rdfs:label "supplies"@en,
        "fournit"@fr ;
    rdfs:domain eco:Fournisseur ;
    rdfs:range eco:Produit ;
    owl:inverseOf eco:estFourniPar .

eco:gere a owl:ObjectProperty ;
    rdfs:label "handles"@en,
        "gère"@fr ;
    rdfs:domain eco:ServiceClient ;
    rdfs:range eco:Commande ;
    owl:inverseOf eco:estGereePar .

eco:livre a owl:ObjectProperty ;
    rdfs:label "delivers"@en,
        "livre"@fr ;
    rdfs:domain eco:Livraison ;
    rdfs:range eco:Commande ;
    owl:inverseOf eco:estLivreePar .

eco:passe a owl:ObjectProperty ;
    rdfs:label "places"@en,
        "passe"@fr ;
    rdfs:domain eco:Client ;
    rdfs:range eco:Commande ;
    owl:inverseOf eco:estPasseePar .

eco:quantite a owl:DatatypeProperty ;
    rdfs:label "quantity"@en,
        "quantité"@fr ;
    rdfs:domain eco:Stock ;
    rdfs:range xsd:integer .

eco:stocke a owl:ObjectProperty ;
    rdfs:label "stores"@en,
        "stocke"@fr ;
    rdfs:domain eco:Entrepot ;
    rdfs:range eco:Stock ;
    owl:inverseOf eco:estStockeDans .

eco:A01 a owl:NamedIndividual,
        eco:Avis ;
    eco:commentaire "Très satisfait" ;
    eco:concerne eco:P01 ;
    eco:estEcritPar eco:C01 ;
    eco:note 5 .

eco:A02 a owl:NamedIndividual,
        eco:Avis ;
    eco:commentaire "Bonne qualité" ;
    eco:concerne eco:P05 ;
    eco:estEcritPar eco:C02 ;
    eco:note 4 .

