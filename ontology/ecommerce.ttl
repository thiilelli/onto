    rdfs:comment "Propriété générique : ses sous-propriétés précisent le domaine."@fr ;
    rdfs:range xsd:string .

var:p a swrl:Variable .

eco:Livraison a owl:Class ;
    rdfs:label "Delivery"@en,
        "Livraison"@fr ;
    rdfs:comment "Acheminement d'une ou plusieurs commandes."@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "100"^^xsd:nonNegativeInteger ;
            owl:onClass eco:Commande ;
            owl:onProperty eco:livre ] .

eco:O01 a owl:NamedIndividual,
        eco:Commande ;
    eco:aPourCoupon eco:Cp01 ;
    eco:contient eco:P01,
        eco:P03 ;
    eco:dateCommande "2025-12-10T14:30:00"^^xsd:dateTime ;
    eco:estGereePar eco:SC01 ;
    eco:estLivreePar eco:L01 ;
    eco:estPasseePar eco:C01 ;
